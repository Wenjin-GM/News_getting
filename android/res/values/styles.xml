<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Reader.Day" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:colorAccent">#155e85</item>
    <item name="android:colorBackground">#f6f8fc</item>
    <item name="android:windowBackground">#f6f8fc</item>
    <item name="android:textColorPrimary">#172e43</item>
    <item name="android:textColorSecondary">#536778</item>
    <item name="android:alertDialogTheme">@style/Reader.Dialog.Day</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>
  <style name="Reader.Night" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:colorAccent">#87d4cc</item>
    <item name="android:colorBackground">#0b111b</item>
    <item name="android:windowBackground">#0b111b</item>
    <item name="android:textColorPrimary">#edf0f4</item>
    <item name="android:textColorSecondary">#9faebb</item>
    <item name="android:alertDialogTheme">@style/Reader.Dialog.Night</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>
  <style name="Reader.Dialog.Day" parent="android:style/Theme.Material.Light.Dialog.Alert">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:colorAccent">#155e85</item>
    <item name="android:colorBackground">#ffffff</item>
    <item name="android:textColorPrimary">#172e43</item>
    <item name="android:textColorSecondary">#536778</item>
    <item name="android:windowMinWidthMajor">90%</item>
    <item name="android:windowMinWidthMinor">92%</item>
  </style>
  <style name="Reader.Dialog.Night" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:colorAccent">#87d4cc</item>
    <item name="android:colorBackground">#131e2b</item>
    <item name="android:textColorPrimary">#edf0f4</item>
    <item name="android:textColorSecondary">#9faebb</item>
    <item name="android:windowMinWidthMajor">90%</item>
    <item name="android:windowMinWidthMinor">92%</item>
  </style>
</resources>
